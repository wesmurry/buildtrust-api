generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  externalId     String?         @unique
  email          String          @unique
  name           String
  role           Role
  phone          String?
  avatar         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  ownedProjects  Project[]       @relation("ProjectOwner")
  gcProjects     Project[]       @relation("ProjectGC")
  changeOrders   ChangeOrder[]   @relation("ChangeOrderInitiator")
  comments       Comment[]
}

enum Role {
  OWNER
  GC
  ADMIN
}

model Project {
  id             String          @id @default(cuid())
  name           String
  address        String
  status         ProjectStatus   @default(PLANNING)
  totalBudget    Float?
  gcFeeModel     GCFeeModel      @default(PERCENTAGE)
  gcFeeAmount    Float           @default(20)
  squareFootage  Float?
  stories        Int?
  bedroomCount   Int?
  bathroomCount  Float?
  garageType     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  ownerId        String
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  gcId           String?
  gc             User?           @relation("ProjectGC", fields: [gcId], references: [id])

  planSets       PlanSet[]
  trades         Trade[]
  changeOrders   ChangeOrder[]
  payments       Payment[]
  materials      MaterialItem[]
  selections     Selection[]
  inspections    Inspection[]
  savings        SavingsEntry[]
  scheduleItems  ScheduleItem[]
}

enum ProjectStatus {
  PLANNING
  PRE_CONSTRUCTION
  ACTIVE
  PUNCH_LIST
  COMPLETE
}

enum GCFeeModel {
  PERCENTAGE
  FLAT
}

model PlanSet {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  fileName       String
  fileUrl        String
  fileSize       Int
  pageCount      Int?
  status         PlanSetStatus   @default(UPLOADED)
  createdAt      DateTime        @default(now())

  sheets         PlanSheet[]
  parsedData     PlanParsedData?
}

enum PlanSetStatus {
  UPLOADED
  PROCESSING
  PARSED
  REVIEWED
  ERROR
}

model PlanSheet {
  id             String          @id @default(cuid())
  planSetId      String
  planSet        PlanSet         @relation(fields: [planSetId], references: [id])
  pageNumber     Int
  sheetType      String?
  thumbnailUrl   String?
  extractedText  String?         @db.Text
  imageUrl       String?
}

model PlanParsedData {
  id               String        @id @default(cuid())
  planSetId        String        @unique
  planSet          PlanSet       @relation(fields: [planSetId], references: [id])
  projectInfo      Json?
  roomSchedule     Json?
  doorSchedule     Json?
  windowSchedule   Json?
  fixtureCount     Json?
  structuralNotes  Json?
  finishSchedule   Json?
  rawExtractions   Json?
  confidence       Json?
  reviewedSections Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Trade {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  name           String
  category       String
  displayOrder   Int             @default(0)
  status         TradeStatus     @default(NOT_STARTED)
  estimatedLow   Float?
  estimatedHigh  Float?
  description    String?         @db.Text
  awardedBidId   String?

  bids           Bid[]
  budgetItem     BudgetLineItem?
  scopeDocument  ScopeDocument?
  invoices       Invoice[]
  scheduleItems  ScheduleItem[]
  scopeLineItems ScopeLineItem[]
  assessments    FairPriceAssessment[]
}

enum TradeStatus {
  NOT_STARTED
  SCOPE_WRITTEN
  OUT_FOR_BID
  AWARDED
  IN_PROGRESS
  COMPLETE
}

model ScopeDocument {
  id               String        @id @default(cuid())
  tradeId          String        @unique
  trade            Trade         @relation(fields: [tradeId], references: [id])
  descriptionOfWork String       @db.Text
  inclusions       Json
  exclusions       Json
  materialSpecs    Json
  qualityStandards Json
  timelineReqs     String?       @db.Text
  version          Int           @default(1)
  generatedByAI    Boolean       @default(true)
  editedByUser     Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Subcontractor {
  id             String          @id @default(cuid())
  name           String
  company        String?
  email          String
  phone          String?
  rating         Float?
  pastProjects   Int?
  trades         String[]
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())

  bids           Bid[]
}

model Bid {
  id              String          @id @default(cuid())
  tradeId         String
  trade           Trade           @relation(fields: [tradeId], references: [id])
  subcontractorId String
  subcontractor   Subcontractor   @relation(fields: [subcontractorId], references: [id])
  totalAmount     Float?
  laborCost       Float?
  materialCost    Float?
  markupPercent   Float?
  timeline        String?
  status          BidStatus       @default(REQUESTED)
  submittedAt     DateTime?
  notes           String?         @db.Text
  attachmentUrl   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  documents       BidDocument[]
  lineItems       BidLineItem[]
  assessments     FairPriceAssessment[]
}

enum BidStatus {
  REQUESTED
  VIEWED
  RECEIVED
  DECLINED
  AWARDED
}

model BudgetLineItem {
  id             String          @id @default(cuid())
  tradeId        String          @unique
  trade          Trade           @relation(fields: [tradeId], references: [id])
  estimated      Float           @default(0)
  bidAmount      Float           @default(0)
  committed      Float           @default(0)
  actualToDate   Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ChangeOrder {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id])
  number         Int
  description    String            @db.Text
  reason         ChangeOrderReason
  initiatedById  String
  initiatedBy    User              @relation("ChangeOrderInitiator", fields: [initiatedById], references: [id])
  tradesAffected String[]
  costImpact     Float
  scheduleImpact Int               @default(0)
  status         ChangeOrderStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  comments       Comment[]
  attachments    Attachment[]
}

enum ChangeOrderReason {
  OWNER_REQUEST
  ARCHITECT_REVISION
  FIELD_CONDITION
  CODE_REQUIREMENT
}

enum ChangeOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

model Comment {
  id             String          @id @default(cuid())
  changeOrderId  String
  changeOrder    ChangeOrder     @relation(fields: [changeOrderId], references: [id])
  authorId       String
  author         User            @relation(fields: [authorId], references: [id])
  content        String          @db.Text
  createdAt      DateTime        @default(now())
}

model Attachment {
  id             String          @id @default(cuid())
  changeOrderId  String
  changeOrder    ChangeOrder     @relation(fields: [changeOrderId], references: [id])
  fileName       String
  fileUrl        String
  fileType       String
  createdAt      DateTime        @default(now())
}

model Payment {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  drawNumber     Int
  milestone      String
  amount         Float
  payee          String
  tradeId        String?
  invoiceNumber  String?
  status         PaymentStatus   @default(UPCOMING)
  scheduledDate  DateTime
  paidDate       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum PaymentStatus {
  UPCOMING
  READY
  PAID
}

model Invoice {
  id             String          @id @default(cuid())
  tradeId        String
  trade          Trade           @relation(fields: [tradeId], references: [id])
  invoiceNumber  String
  amount         Float
  fileUrl        String?
  receivedDate   DateTime
  paidDate       DateTime?
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
}

model MaterialItem {
  id                  String          @id @default(cuid())
  projectId           String
  project             Project         @relation(fields: [projectId], references: [id])
  name                String
  specification       String?
  category            String
  supplier            String?
  unitCost            Float?
  quantity            Float?
  totalCost           Float?
  leadTimeDays        Int?
  orderDate           DateTime?
  expectedDelivery    DateTime?
  neededByDate        DateTime?
  status              MaterialStatus  @default(NOT_ORDERED)
  alternativeSuppliers Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

enum MaterialStatus {
  NOT_ORDERED
  ORDERED
  SHIPPED
  DELIVERED
  INSTALLED
}

model Selection {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id])
  category        String
  subcategory     String?
  allowanceAmount Float
  selectedProduct String?
  selectedCost    Float?
  supplier        String?
  photoUrl        String?
  specUrl         String?
  status          SelectionStatus @default(NOT_SELECTED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum SelectionStatus {
  NOT_SELECTED
  SELECTED
  ORDERED
  INSTALLED
}

model Inspection {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  type             String
  displayOrder     Int               @default(0)
  requiredDate     DateTime?
  scheduledDate    DateTime?
  inspector        String?
  result           InspectionResult?
  notes            String?           @db.Text
  corrections      String?           @db.Text
  reInspectionDate DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum InspectionResult {
  PASS
  FAIL
  CONDITIONAL
}

model ScheduleItem {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  tradeId        String?
  trade          Trade?          @relation(fields: [tradeId], references: [id])
  name           String
  phase          String
  startDate      DateTime
  endDate        DateTime
  duration       Int?
  progress       Int             @default(0)
  dependencies   String[]
  status         ScheduleStatus  @default(NOT_STARTED)
  isMilestone    Boolean         @default(false)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum ScheduleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  DELAYED
}

model SavingsEntry {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  date           DateTime
  category       SavingsCategory
  description    String
  amountSaved    Float
  source         String?
  createdAt      DateTime        @default(now())
}

enum SavingsCategory {
  COMPETITIVE_BIDDING
  MATERIAL_SOURCING
  NEGOTIATION
  SCOPE_OPTIMIZATION
  OTHER
}

// ============================================================================
// FAIRNESS ENGINE (schema v2)
//
// Conventions that differ from the legacy tables above:
//   - All money is integer CENTS (penny-safe). Never Float.
//   - Every reference-data row carries a DataSource + sourceRef so each layer
//     of a fair-price band is auditable down to its origin.
//   - The bottom-up layers (labor units, wages, materials, margins) are kept
//     structurally separate from PLATFORM_OBSERVED data so the two can never
//     silently feed each other (anti-circularity).
// ============================================================================

enum DataSource {
  BLS_OEWS           // Bureau of Labor Statistics OEWS wage data (public)
  PUBLISHED_ESTIMATE // Rule-of-thumb from published trade literature — placeholder pending licensed data
  PHCC               // PHCC Labor Unit Database (license required)
  NECA               // NECA Manual of Labor Units (license required)
  MCAA               // MCAA WebLEM (license required)
  CRAFTSMAN          // Craftsman Book licensed cost data
  SUPPLIER_FEED      // Live supplier / dealer material pricing
  PLATFORM_OBSERVED  // BuildTrust's own bid flow — never mixed into bottom-up layers
  MANUAL             // Builder-entered
}

enum ScopeLineCategory {
  LABOR
  MATERIAL
  EQUIPMENT
  ALLOWANCE
  GENERAL
}

// One row of the trade's scope sheet — the normalization key for leveling.
model ScopeLineItem {
  id            String            @id @default(cuid())
  tradeId       String
  trade         Trade             @relation(fields: [tradeId], references: [id])
  csiCode       String?
  description   String
  category      ScopeLineCategory @default(GENERAL)
  quantity      Float
  unit          String            // SF, LF, EA, SQ, CY, HR, LS
  laborTaskCode String?           // -> LaborUnit.taskCode (LABOR lines)
  materialCode  String?           // -> MaterialPriceRef.itemCode (MATERIAL lines)
  displayOrder  Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  bidLineItems  BidLineItem[]
}

// Raw artifact a sub sent (email body, OCR'd PDF text) + parse provenance.
model BidDocument {
  id              String    @id @default(cuid())
  bidId           String
  bid             Bid       @relation(fields: [bidId], references: [id])
  fileName        String?
  rawText         String    @db.Text
  parsedAt        DateTime?
  parseModel      String?
  parserVersion   String?
  parseConfidence Float?
  createdAt       DateTime  @default(now())
}

enum BidLineKind {
  INCLUSION
  EXCLUSION
  ALLOWANCE
  ALTERNATE
}

// A leveled line of a sub's bid, matched (where possible) to the scope sheet.
model BidLineItem {
  id              String         @id @default(cuid())
  bidId           String
  bid             Bid            @relation(fields: [bidId], references: [id])
  scopeLineItemId String?
  scopeLineItem   ScopeLineItem? @relation(fields: [scopeLineItemId], references: [id])
  description     String
  kind            BidLineKind    @default(INCLUSION)
  quantity        Float?
  unit            String?
  unitPriceCents  Int?
  totalCents      Int            @default(0)
  laborCents      Int?
  materialCents   Int?
  confidence      Float?         // AI parse confidence, null when manually entered
  sourceText      String?        @db.Text // provenance: text span this line came from
  createdAt       DateTime       @default(now())
}

// Labor productivity: hours per unit of work, by trade task.
model LaborUnit {
  id            String     @id @default(cuid())
  tradeCategory String     // matches Trade.category
  taskCode      String     @unique
  description   String
  unit          String     // per SF, EA, SQ, LF...
  hoursPerUnit  Float
  conditions    String?    // "standard conditions" caveats
  source        DataSource
  sourceRef     String?
  effectiveDate DateTime?
}

// Local prevailing wages by metro + occupation (BLS OEWS).
model WageRate {
  id                String     @id @default(cuid())
  msaCode           String     // BLS MSA code, e.g. 12420 = Austin-Round Rock
  msaName           String
  socCode           String     // e.g. 47-2111
  occupation        String
  hourlyMedianCents Int
  hourlyP75Cents    Int
  source            DataSource
  sourceRef         String?    // BLS series id
  asOf              DateTime

  @@unique([msaCode, socCode, asOf])
}

// Wage -> burdened crew cost conversion, by state + trade.
model BurdenFactor {
  id             String     @id @default(cuid())
  state          String
  tradeCategory  String
  payrollTaxPct  Float      // e.g. 0.09
  workersCompPct Float      // e.g. 0.07 — the dominant per-trade variable
  otherPct       Float      @default(0)
  multiplier     Float      // 1 + sum of the above, stored for convenience
  source         DataSource
  sourceRef      String?

  @@unique([state, tradeCategory])
}

// Per-trade overhead + net margin norms (the O&P layer of the band).
model TradeMarginNorm {
  id              String     @id @default(cuid())
  tradeCategory   String     @unique
  overheadPctLow  Float
  overheadPctHigh Float
  netMarginPctLow Float
  netMarginPctHigh Float
  basis           String?    // e.g. "residential install margins, not blended service"
  source          DataSource
  sourceRef       String?
  asOf            DateTime?
}

// Reference material prices (licensed data or supplier feeds).
model MaterialPriceRef {
  id             String     @id @default(cuid())
  itemCode       String
  description    String
  unit           String
  unitPriceCents Int
  region         String     // metro code or 'US'
  source         DataSource
  sourceRef      String?
  asOf           DateTime

  @@unique([itemCode, region, asOf])
}

// Market-heat adjustment: subs price by backlog, not cost, in hot markets.
model MarketHeatFactor {
  id            String     @id @default(cuid())
  msaCode       String
  tradeCategory String
  factor        Float      // 1.00 neutral; 1.08 = +8%
  basis         String
  source        DataSource
  asOf          DateTime

  @@unique([msaCode, tradeCategory, asOf])
}

enum AssessmentStatus {
  BLOCKED_SCOPE_GATE // leveling gate failed — no verdict may be rendered
  DRAFT              // computed, awaiting builder review
  BUILDER_REVIEWED   // builder approved the assessment
  CLIENT_VISIBLE     // published to the homeowner portal
}

enum VerdictZone {
  WITHIN_RANGE
  ABOVE_RANGE // with the line items driving it
  BELOW_RANGE // scope-gap risk: verify coverage before celebrating
}

// One computed fair-price band for a trade (optionally against a specific bid).
model FairPriceAssessment {
  id                 String           @id @default(cuid())
  tradeId            String
  trade              Trade            @relation(fields: [tradeId], references: [id])
  bidId              String?
  bid                Bid?             @relation(fields: [bidId], references: [id])
  status             AssessmentStatus @default(DRAFT)
  scopeGate          Json             // coverage %, unmatched lines, exclusion conflicts
  bandLowCents       Int
  bandHighCents      Int
  pointEstimateCents Int              // internal midpoint — never shown as "the" price
  bandPct            Float            // 0.15 labor-heavy custom, 0.10 commodity-unit
  verdict            VerdictZone?
  layers             Json             // full per-layer breakdown with provenance
  assumptions        Json             // human-readable assumption list for the report
  marketHeatFactor   Float            @default(1)
  engineVersion      String
  computedAt         DateTime
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}
